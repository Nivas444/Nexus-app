{
  "headers": [
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "https://nexus-app-g2i9.onrender.com/health"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://nexus-app-g2i9.onrender.com/api/v1/:path*"
    },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/home.html", "destination": "/frontend/home.html" },
    { "source": "/home", "destination": "/frontend/home.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/icons/(.*)", "destination": "/frontend/icons/$1" },
    { "source": "/bulk upload template/(.*)", "destination": "/frontend/bulk upload template/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
