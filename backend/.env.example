# =============================================================================
# Nexus ERP Backend Environment Configuration (Safe Placeholders Only)
# Configure actual values in Render Environment Variables or local .env
# NEVER commit real credentials, passwords, or keys to Git.
# =============================================================================

ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=Nexus ERP API
API_V1_STR=/api/v1

# Option A: Full Supabase / Render PostgreSQL Connection String
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Discrete PostgreSQL Credentials
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_PROJECT_NAME=postgres
DB_ACCOUNTS_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Existing 7 Supabase Schemas (Do NOT rename or drop)
DB_MASTER_SCHEMA=nexus_master
DB_PROJECT_SCHEMA=nexus_project
DB_ACCOUNTS_SCHEMA=nexus_accounts
DB_ADMIN_SCHEMA=nexus_admin
DB_INFRA_INVENTORY_SCHEMA=nexus_infra_inventory
DB_INVENTORY_SCHEMA=nexus_inventory
DB_PURCHASE_SCHEMA=nexus_purchase

# Supabase Backend-Only Configuration (Never expose in frontend / Vercel)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=CHANGE_ME_OPTIONAL_SUPABASE_JWT_SECRET

# Centralized JWT Authentication Configuration
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=nexus-erp
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings (Production via Vercel same-origin proxy: COOKIE_SECURE=true, COOKIE_SAMESITE=lax)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# CORS Allowed Origins (Comma-separated list; include your Vercel production URL)
CORS_ORIGINS=https://nexus-app-trail.vercel.app,http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:8000

# Login Rate Limiting & Account Lockout
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=15
